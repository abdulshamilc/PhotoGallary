# ====================================================================
# ASHHAR & MUFEEDA WEDDING GALLERY - PRODUCTION ENVIRONMENT VARIABLES
# ====================================================================

# 1. Firebase Web Configuration
# Retrieve from: Firebase Console > Project Settings > General > Web Apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# 2. Google Drive API Credentials
# Create a Browser Key in Google Cloud Console > APIs & Services > Credentials
# Enable Google Drive API v3 in your Google Cloud Project
VITE_GOOGLE_API_KEY=your_google_cloud_api_key_here

# 3. Google Drive Wedding Album Folder ID
# Extract the folder ID from your Google Drive folder link:
# https://drive.google.com/drive/folders/YOUR_FOLDER_ID_HERE
VITE_GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
